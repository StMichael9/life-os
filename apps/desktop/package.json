{
  "name": "@life-os/desktop",
  "private": true,
  "version": "0.2.0",
  "description": "Life OS Windows shell",
  "author": "Life OS",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "pnpm --filter @life-os/web build && pnpm build && electron .",
    "typecheck": "tsc --noEmit",
    "test:native": "node scripts/verify-native.mjs",
    "test:gui": "node scripts/build-gui.mjs && playwright test --config playwright.config.ts",
    "test:offline": "pnpm build && playwright test --config playwright.offline.config.ts",
    "package:win": "pnpm --filter @life-os/web build && node scripts/build.mjs --release && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.1",
    "selfsigned": "5.5.0"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
