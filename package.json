{
  "name": "life-os",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @life-os/web dev",
    "build": "pnpm --filter @life-os/web build && pnpm --filter @life-os/desktop build",
    "typecheck": "tsc --project tsconfig.tools.json && pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @life-os/database generate",
    "db:migrate": "pnpm --filter @life-os/database migrate",
    "desktop:dev": "pnpm --filter @life-os/desktop dev",
    "account:create": "pnpm --filter @life-os/api account:create"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vitest": "^4.0.18",
    "@axe-core/playwright": "^4.11.0"
  },
  "type": "module"
}
