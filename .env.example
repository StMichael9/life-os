# Server only. Never prefix credentials with NEXT_PUBLIC_. Export variables for CLI commands.
DATABASE_URL=postgresql://life_os:local_only@localhost:5432/life_os
# Generate a separate random secret per environment: openssl rand -base64 48
AUTH_SECRET=
# Production requires the exact HTTPS origin, without trailing slash or path.
APP_ORIGIN=http://localhost:3000
# Local development only. Never enable this for a deployed application.
AUTH_ALLOW_HTTP_LOOPBACK=true
# Embedded in the Electron executable at build time. HTTPS required for releases.
LIFE_OS_WEB_URL=http://localhost:3000
# Optional disposable integration databases. Tests TRUNCATE fixtures; never use real data.
# LIFE_OS_TEST_DATABASE_URL=postgresql://.../life_os_auth_tests
# LIFE_OS_E2E_DATABASE_URL=postgresql://.../life_os_e2e
