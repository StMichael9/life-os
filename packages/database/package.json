{
  "name": "@life-os/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./embedded": "./src/embedded.ts",
    "./schema": "./src/schema.ts",
    "./embedded-backup": "./src/embedded-backup.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "release:migrate": "tsx src/operations-cli.ts migrate",
    "release:verify": "tsx src/operations-cli.ts verify",
    "release:runtime": "tsx src/operations-cli.ts runtime",
    "backup": "tsx src/operations-cli.ts backup",
    "restore": "tsx src/operations-cli.ts restore"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@life-os/shared": "workspace:*",
    "@life-os/validation": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.21.0"
  }
}
